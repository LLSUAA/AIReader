{
  "manifest_version": 3,
  "name": "读见 - 深度阅读与知识提取工具",
  "version": "1.1.0",
  "description": "把书读成框架，把理解沉淀为自己的知识资产",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "action": {
    "default_title": "打开读见阅读引擎"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
